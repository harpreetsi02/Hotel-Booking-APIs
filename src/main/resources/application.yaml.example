spring:
  application:
    name: hotelbooking-api
  datasource:
    url: jdbc:postgresql://localhost:5432/hotelbooking_db
    username: <DB_postgres>
    password: <YOUR_PASSWORD>
  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

server: 8080